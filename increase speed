# 1. Mount USB with noatime (stops writing timestamps on every file read)
sudo sed -i 's/relatime/noatime,commit=60/g' /etc/fstab
sudo mount -o remount,noatime,commit=60 /

# 2. Tell Linux to cache all files and folders in your 12 GB RAM
sudo tee /etc/sysctl.d/99-usb-speed.conf > /dev/null << 'EOF'
vm.vfs_cache_pressure = 50
vm.dirty_background_ratio = 5
vm.dirty_ratio = 10
EOF
sudo sysctl --system

# 3. Install and activate 6 GB ZRAM in memory
sudo pacman -Sy --noconfirm zram-generator
sudo tee /etc/systemd/zram-generator.conf > /dev/null << 'EOF'
[zram0]
zram-size = min(ram / 2, 6144)
compression-algorithm = zstd
EOF
sudo systemctl daemon-reload
sudo systemctl start systemd-zram-setup@zram0.service
